# Copy this file to .env and fill in the values. .env is git-ignored.
# Local database (only reachable from this PC). Pick any password.
POSTGRES_USER=jobs
POSTGRES_PASSWORD=
POSTGRES_DB=jobs
DATABASE_URL=postgresql://jobs:<password>@127.0.0.1:5432/jobs

# Azure database (cloud copy): the Azure admin URL, ending in ?sslmode=require.
# Leave blank to skip the cloud load. NEVER put this URL in DATABASE_URL: the tests create
# and drop throwaway schemas in whatever DATABASE_URL points at.
AZURE_DATABASE_URL=

# Lets the daily run point the Azure firewall rule at today's home IP (jobpilot/azure_firewall.py).
# From the Entra app `jobpilot-firewall-updater`, whose only role is a custom one on the database server
# (firewall rules read/write). The client secret expires: renew it before its expiry date (put it in your calendar).
AZURE_TENANT_ID=
AZURE_CLIENT_ID=
AZURE_CLIENT_SECRET=
AZURE_SUBSCRIPTION_ID=

# Key that callers of the API (uvicorn jobpilot.api:app) send in the X-API-Key header.
# Left blank, every data endpoint answers 503. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
JOBPILOT_API_KEY=

# Copy of the deployed API's key (Container App secret api-key), for calling the live API from scripts.
JOBPILOT_CLOUD_API_KEY=

# Telegram bot token from @BotFather (scripts only; the flow keeps its own copy with Secure Inputs on).
TELEGRAM_BOT_TOKEN=

# Telegram webhook (POST /telegram/webhook). The secret is what setWebhook's secret_token was set to;
# Telegram sends it back on every call. Left blank, the webhook answers 503. Generate it with:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
TELEGRAM_WEBHOOK_SECRET=
# Your own Telegram user id (a number): only your private chat with the bot is obeyed. Never commit it.
TELEGRAM_OWNER_ID=
# Database URL logging in as jobpilot_feedback (migration 004), the webhook's only write access.
FEEDBACK_DATABASE_URL=

# Jooble API key (free, request it at https://tr.jooble.org/api/about). It works only on tr.jooble.org.
# The free key has a LIFETIME limit of 500 requests; the daily run spends one per Jooble search (~3/day).
# Leave blank to skip the Jooble source.
JOOBLE_API_KEY=

# APIFY_TOKEN is read from your Windows user environment variables, not from here.
